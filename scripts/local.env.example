# Copy to scripts/local.env (git ignores it) and edit. scripts/xi-client.sh reads it before starting the client.

# The game data. Leave this unset: `xi-setup import` copies the files the client needs into
# ~/.local/share/ffxi-linux/game and every app finds them there. Set it only to use another folder (one with
# FFXiMain.dll and ROM/), e.g. an install you don't want to copy.
#export FFXI_ROOT="$HOME/Games/ffxi/drive_c/Program Files (x86)/PlayOnline/SquareEnix/FINAL FANTASY XI"

# Your LSB checkout (the client reads res/compress.dat from it). Default: ~/server, ~/git/server, ~/LandSandBoat.
#export LSB_DIR="$HOME/server"

# The LSB server's address. Default: 127.0.0.1.
#XI_HOST=192.168.1.20

# Which monitor: secondary (default), primary, or an index (0, 1, 2 ...).
#export XI_DISPLAY=primary

# Several clients side by side: each character's window fills one quarter of the display (tl, tr, bl, br).
#export XI_WINDOW_SLOTS="Alice=tl,Bob=tr,Carol=bl,Dave=br"

# Arguments added to every launch, e.g. a pre-filled login form.
#XI_ARGS=(--user myaccount --pass mypassword --char Mychar)
