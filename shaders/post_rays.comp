#version 460
// --post=godrays without --rt: screen-space light shafts. The bright open sky around light 0 is blurred radially toward
// its screen position and added to the in-scattered light (half resolution).
#extension GL_GOOGLE_include_directive : require
#include "post_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba16f) uniform image2D vol;
layout(set = 0, binding = 1) uniform sampler2D sceneTex; // the working buffer, still the game's values (before post_prep)
layout(set = 0, binding = 2) uniform sampler2D depthTex;

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, ivec2(pc.size.xy))) || pc.sun.z <= 0.0)
    {
        return;
    }
    vec2  uv    = (vec2(px) + 0.5) * pc.size.zw;
    vec2  delta = (pc.sun.xy - uv) / 48.0;
    vec2  p     = uv;
    float decay = 1.0;
    vec3  acc   = vec3(0.0);
    for (int i = 0; i < 48; ++i)
    {
        p += delta;
        if (any(lessThan(p, vec2(0.0))) || any(greaterThan(p, vec2(1.0))))
        {
            break;
        }
        float d = textureLod(depthTex, p, 0.0).r;
        vec3  c = textureLod(sceneTex, p, 0.0).rgb;
        float m = d <= 0.0 ? max(luma(c) - 0.35, 0.0) : 0.0; // the open sky only
        acc += toLinear(c) * m * decay;
        decay *= 0.965;
    }
    vec4 v = imageLoad(vol, px);
    v.rgb += acc * (pc.ambient.w * pc.sun.z * 0.01) * toLinear(pc.lightColor.rgb + 0.3);
    imageStore(vol, px, v);
}
