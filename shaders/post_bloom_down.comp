#version 460
// --post=bloom: one level down the bloom chain. The first level (eye.w < 0, set by post.cpp) keeps only what is brighter
// than white in the HDR scene (soft knee); the rest box-filter the level above with 4 bilinear taps.
#extension GL_GOOGLE_include_directive : require
#include "post_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D dst;
layout(set = 0, binding = 1) uniform sampler2D src;

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, ivec2(pc.size.xy))))
    {
        return;
    }
    vec2 uv = (vec2(px) + 0.5) * pc.size.zw;
    vec2 o  = 0.5 * pc.size.zw;
    vec3 c  = 0.25 * (textureLod(src, uv + vec2(-o.x, -o.y), 0.0).rgb + textureLod(src, uv + vec2(o.x, -o.y), 0.0).rgb +
                     textureLod(src, uv + vec2(-o.x, o.y), 0.0).rgb + textureLod(src, uv + vec2(o.x, o.y), 0.0).rgb);
    if (pc.eye.w < 0.0)
    {
        const float kThr = 1.8, kKnee = 0.6;
        float       br   = max(c.r, max(c.g, c.b));
        float       soft = clamp(br - kThr + kKnee, 0.0, 2.0 * kKnee);
        soft             = soft * soft / (4.0 * kKnee + 1e-4);
        c *= max(soft, br - kThr) / max(br, 1e-4);
    }
    imageStore(dst, px, vec4(c, 1.0));
}
