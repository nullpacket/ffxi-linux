#version 460
#extension GL_GOOGLE_include_directive : require
#include "rt_common.glsl"

// --rt with --dlss Ray Reconstruction (goal 38): the guides DLSS-RR reads. Diffuse albedo is the pixel as the game
// drew it, unfogged and divided by its lighting (ambient + light 0 / 1); the zone materials have no specular, so a
// low constant; the normal from the depth, roughness 1 (packed in w).
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D sceneTex; // before the re-lighting
layout(set = 0, binding = 1) uniform sampler2D tA;       // ao, visibility, oct normal
layout(set = 0, binding = 2) uniform sampler2D depthTex;
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D outAlbedo;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D outNormal;
layout(set = 0, binding = 5, rgba8) uniform writeonly image2D outSpecular;

layout(push_constant) uniform Push
{
    Params p;
    uint   pass;
} pc;

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, ivec2(pc.p.size.xy))))
    {
        return;
    }
    float d = texelFetch(depthTex, px, 0).r;
    vec3  c = texelFetch(sceneTex, px, 0).rgb;
    if (d <= 0.0) // sky: its own colour, facing the camera
    {
        imageStore(outAlbedo, px, vec4(c, 1.0));
        imageStore(outNormal, px, vec4(0.0, 1.0, 0.0, 1.0));
        imageStore(outSpecular, px, vec4(0.0));
        return;
    }
    vec3  n    = octDecode(texelFetch(tA, px, 0).zw);
    vec2  uv   = (vec2(px) + 0.5) * pc.p.size.zw;
    vec3  w    = worldAt(pc.p, uv, d);
    float dist = distance(w, pc.p.eye.xyz);
    float f    = clamp((pc.p.fogColorEnd.w - dist) / max(pc.p.fogColorEnd.w - pc.p.fogStart.x, 1e-3), 0.0, 1.0);
    vec3  lit  = (c - (1.0 - f) * pc.p.fogColorEnd.rgb) / max(f, 0.05);
    vec3  sum  = pc.p.ambient.rgb + pc.p.light0Color.rgb * max(dot(n, normalize(pc.p.light0Dir.xyz)), 0.0) +
                pc.p.light1Color.rgb * max(dot(n, normalize(pc.p.light1Dir.xyz)), 0.0);
    imageStore(outAlbedo, px, vec4(clamp(lit / max(sum, vec3(0.05)), 0.0, 1.0), 1.0));
    imageStore(outNormal, px, vec4(n, 1.0));
    imageStore(outSpecular, px, vec4(0.04, 0.04, 0.04, 1.0));
}
